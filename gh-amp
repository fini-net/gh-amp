#!/usr/bin/env bash
set -euo pipefail

VERSION="0.1.0"

BOLD=$'\033[1m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
RED=$'\033[31m'
BLUE=$'\033[34m'
CYAN=$'\033[36m'
DIM=$'\033[2m'
RESET=$'\033[0m'

sanitize() {
    printf '%s' "$1" | sed $'s/\033\\[[0-9;]*m//g'
}

check_dependencies() {
    for cmd in gh jq; do
        if ! command -v "$cmd" &>/dev/null; then
            echo "Error: Required command '$cmd' not found. Please install it first." >&2
            exit 1
        fi
    done
}

REPO=""
STATE="open"
LIMIT=30
AUTHOR=""
LABEL=""
SEARCH=""
MERGE_STRATEGY="squash"

usage() {
    cat <<EOF
${BOLD}gh amp${RESET} - Approve, Merge, Pull workflow for GitHub PRs

${BOLD}USAGE${RESET}
    gh amp <command> [flags]

When no command is given, defaults to ${BOLD}review${RESET}.

${BOLD}COMMANDS${RESET}
    list      List pull requests with optional filters
    status    Show CI status for pull request(s)
    review    Interactive workflow: select PR, view status, approve/merge/pull
              (default when no command is given)

${BOLD}FLAGS${RESET}
    -R, --repo [HOST/]OWNER/REPO   Select another repository
    -A, --author string            Filter by PR author
    -l, --label string             Filter by label
    -s, --state string             Filter by state: open|closed|merged|all (default: open)
    -L, --limit int                Maximum number of PRs to fetch (default: 30)
    -S, --search string            Search query for filtering PRs
        --merge-strategy string    Merge strategy: squash|merge|rebase (default: squash)
        --version                  Show version
    -h, --help                     Show help

${BOLD}EXAMPLES${RESET}
    # List open PRs for the current repo
    \$ gh amp list

    # List PRs authored by you
    \$ gh amp list --author @me

    # Show CI status for a specific PR
    \$ gh amp status 42

    # Show CI status for current branch's PR
    \$ gh amp status

    # Interactive review workflow
    \$ gh amp review

    # Review PRs in a specific repo
    \$ gh amp review -R fini-net/gh-amp

EOF
}

version() {
    echo "gh-amp v${VERSION}"
}

log_info() {
    echo -e "${BLUE}ℹ${RESET} $*"
}

log_success() {
    echo -e "${GREEN}✓${RESET} $*"
}

log_warn() {
    echo -e "${YELLOW}⚠${RESET} $*"
}

log_error() {
    echo -e "${RED}✗${RESET} $*" >&2
}

pr_list_args() {
    local args=()
    args+=(--state "$STATE")
    args+=(--limit "$LIMIT")

    if [[ -n "$REPO" ]]; then
        args+=(--repo "$REPO")
    fi
    if [[ -n "$AUTHOR" ]]; then
        args+=(--author "$AUTHOR")
    fi
    if [[ -n "$LABEL" ]]; then
        args+=(--label "$LABEL")
    fi
    if [[ -n "$SEARCH" ]]; then
        args+=(--search "$SEARCH")
    fi

    printf '%s\n' "${args[@]}"
}

resolve_owner_repo() {
    # Resolve OWNER/REPO for GraphQL from $REPO (or the current repo when unset).
    # Prints "owner name" on stdout, or nothing on failure (graceful degradation).
    # Handles the documented [HOST/]OWNER/REPO form for --repo.
    local repo_target="$REPO"
    if [[ -z "$repo_target" ]]; then
        repo_target="$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null)" || true
    fi
    [[ -z "$repo_target" ]] && return 0

    # Strip a host prefix if present. A host-prefixed target has exactly two
    # slashes (host/owner/repo); the plain form has one (owner/repo). Stripping
    # a single leading segment yields owner/repo in both cases.
    if [[ "$repo_target" == */*/* ]]; then
        repo_target="${repo_target#*/}"
    fi

    local owner name
    owner="${repo_target%%/*}"
    name="${repo_target#*/}"
    if [[ -z "$owner" || -z "$name" || "$owner" == "$repo_target" ]]; then
        return 0
    fi
    printf '%s %s' "$owner" "$name"
}

refine_checks_status() {
    # Refine a BLOCKED/UNSTABLE/DIRTY mergeStateStatus using required checks.
    # Reads required-check buckets from `gh pr checks --required` and prints
    # one of: failing | pending | passing
    # Degradation: on any error, prints "pending". This path is only reached
    # when mergeStateStatus is BLOCKED/UNSTABLE/DIRTY (GitHub already signaled
    # something blocks merge), so a fetch failure must not be reported as
    # "passing" -- that would be the misleading green light issue #21 fixed.
    # Note: `gh pr checks --required --json bucket` requires a recent gh CLI;
    # an older client hits this same fallback and will see "pending".
    #
    # Trade-off (N+1 calls): BLOCKED is the common state for PRs awaiting
    # review, so `gh amp list` (default --limit 30) with many such PRs will
    # fire up to ~30 sequential `gh pr checks --required` subprocess + API
    # round trips on top of the single batched GraphQL query. This is the
    # accepted cost of surfacing required-check signal next to mergeable; if
    # list latency bites in practice, cap the count or parallelize the calls
    # here (e.g. via background jobs / xargs -P).
    local pr_number="$1"

    local repo_args=()
    if [[ -n "$REPO" ]]; then
        repo_args+=(--repo "$REPO")
    fi

    local buckets
    buckets="$(gh pr checks "$pr_number" ${repo_args[@]+"${repo_args[@]}"} --required --json bucket 2>/dev/null)" || {
        printf 'pending'
        return 0
    }

    if [[ -z "$buckets" || "$buckets" == "[]" ]]; then
        # No required checks configured -> nothing required, treat as passing.
        printf 'passing'
        return 0
    fi

    if printf '%s' "$buckets" | jq -e 'any(.[]; .bucket == "fail" or .bucket == "cancel")' >/dev/null 2>&1; then
        printf 'failing'
        return 0
    fi
    if printf '%s' "$buckets" | jq -e 'any(.[]; .bucket == "pending")' >/dev/null 2>&1; then
        printf 'pending'
        return 0
    fi
    printf 'passing'
}

checks_status() {
    # Print the required-check status for a single PR: passing|pending|failing|<empty>
    # Uses GraphQL mergeStateStatus as the primary signal and refines
    # BLOCKED/UNSTABLE/DIRTY with `gh pr checks --required`.
    # Empty output means the status could not be determined (graceful degradation).
    local pr_number="$1"

    local resolved owner name
    resolved="$(resolve_owner_repo)" || true
    [[ -z "$resolved" ]] && return 0
    read -r owner name <<< "$resolved"

    local mss
    # shellcheck disable=SC2016
    mss="$(gh api graphql \
        -F owner="$owner" -F name="$name" -F pr="$pr_number" \
        -f query='query($owner:String!,$name:String!,$pr:Int!){repository(owner:$owner,name:$name){pullRequest(number:$pr){mergeStateStatus}}}' \
        --jq '.data.repository.pullRequest.mergeStateStatus' 2>/dev/null)" || true

    case "$mss" in
        CLEAN|BEHIND|HAS_HOOKS) printf 'passing' ;;
        UNKNOWN) printf 'pending' ;;
        BLOCKED|UNSTABLE|DIRTY) refine_checks_status "$pr_number" ;;
        DRAFT)
            # Draft PRs have no required-check signal worth surfacing.
            return 0
            ;;
        *)
            # Unhandled mergeStateStatus (including empty) -> degrade silently.
            return 0
            ;;
    esac
}

batch_checks_status() {
    # Print required-check status for multiple PRs in one GraphQL query.
    # Input: newline-delimited PR numbers on stdin.
    # Output: "<num> <status>" lines, one per input number.
    # Status is one of passing|pending|failing|<empty on error/degradation>.
    local nums=()
    local n
    while IFS= read -r n; do
        [[ -z "$n" ]] && continue
        nums+=("$n")
    done
    (( ${#nums[@]} == 0 )) && return 0

    # Filter to numeric PR numbers so the splice into the GraphQL query string
    # below stays safe. nums come from `gh pr list --json number` (trusted),
    # but make that assumption explicit rather than implicit.
    local filtered=()
    for n in "${nums[@]}"; do
        [[ "$n" =~ ^[0-9]+$ ]] && filtered+=("$n")
    done
    nums=("${filtered[@]}")
    (( ${#nums[@]} == 0 )) && return 0

    local resolved owner name
    resolved="$(resolve_owner_repo)" || true
    if [[ -z "$resolved" ]]; then
        # Cannot resolve repo -> emit empty status per PR.
        for n in "${nums[@]}"; do printf '%s \n' "$n"; done
        return 0
    fi
    read -r owner name <<< "$resolved"

    # Build a GraphQL query with one alias per PR number.
    # shellcheck disable=SC2016
    local query='query($owner:String!,$name:String!){ repository(owner:$owner,name:$name){'
    local idx=1
    for n in "${nums[@]}"; do
        # Aliases must match /^[_A-Za-z][_0-9A-Za-z]*$/ -> use "pr" prefix.
        query+=" pr${idx}: pullRequest(number:${n}){ mergeStateStatus }"
        ((idx++)) || true
    done
    query+=' } }'

    local data
    data="$(gh api graphql -F owner="$owner" -F name="$name" -f query="$query" 2>/dev/null)" || {
        for n in "${nums[@]}"; do printf '%s \n' "$n"; done
        return 0
    }

    idx=1
    for n in "${nums[@]}"; do
        local mss
        mss="$(printf '%s' "$data" | jq -r ".data.repository.pr${idx}.mergeStateStatus // \"\"" 2>/dev/null)" || mss=""
        local status=""
        case "$mss" in
            CLEAN|BEHIND|HAS_HOOKS) status="passing" ;;
            UNKNOWN) status="pending" ;;
            BLOCKED|UNSTABLE|DIRTY)
                status="$(refine_checks_status "$n")"
                ;;
            DRAFT)
                # Draft PRs have no required-check signal worth surfacing.
                status=""
                ;;
            *)
                # Unhandled mergeStateStatus (including empty) -> degrade silently.
                status=""
                ;;
        esac
        printf '%s %s\n' "$n" "$status"
        ((idx++)) || true
    done
}

color_for_status() {
    case "$1" in
        passing) printf '%s' "$GREEN" ;;
        pending) printf '%s' "$YELLOW" ;;
        failing) printf '%s' "$RED" ;;
        *) printf '%s' "$RESET" ;;
    esac
}

fetch_prs_json() {
    # Print the `gh pr list` JSON for the current filter globals, or nothing.
    # Shared by cmd_list and select_pr to avoid drift in the args construction.
    local gh_args=(pr list)
    local filter_args
    filter_args="$(pr_list_args)"
    while IFS= read -r arg; do
        gh_args+=("$arg")
    done <<< "$filter_args"

    gh_args+=("--json" "number,title,author,headRefName,baseRefName,reviewDecision,mergeable")

    gh "${gh_args[@]}"
}

lookup_check_status() {
    # Print the checks-status for a PR number looked up in a checks_map
    # ("<num> <status>" lines as produced by batch_checks_status).
    # Empty output when the number is absent or status is empty.
    local num="$1"
    local checks_map="$2"
    printf '%s\n' "$checks_map" | awk -v n="$num" '$1==n{$1="";sub(/^ /,"");print;exit}'
}

cmd_list() {
    local prs
    prs="$(fetch_prs_json)"

    if [[ -z "$prs" || "$prs" == "[]" ]]; then
        return 0
    fi

    # Batch-fetch required-check status for all listed PRs.
    local checks_map
    checks_map="$(printf '%s\n' "$prs" | jq -r '.[].number' | batch_checks_status)" || checks_map=""

    echo -e "${BOLD}  PR   Title                                                    Author         Branch                Base            Review        Mergeable${RESET}"

    while IFS= read -r line; do
        local num title author_login branch base review mergeable
        num="$(echo "$line" | jq -r '.number')"
        title="$(sanitize "$(echo "$line" | jq -r '.title')")"
        author_login="$(sanitize "$(echo "$line" | jq -r '.author.login')")"
        branch="$(sanitize "$(echo "$line" | jq -r '.headRefName')")"
        base="$(sanitize "$(echo "$line" | jq -r '.baseRefName')")"
        review="$(echo "$line" | jq -r '.reviewDecision')"
        mergeable="$(echo "$line" | jq -r '.mergeable')"

        local status
        status="$(lookup_check_status "$num" "$checks_map")" || status=""

        local mergeable_display="${mergeable}"
        if [[ -n "$status" ]]; then
            local status_color
            status_color="$(color_for_status "$status")"
            mergeable_display="${mergeable} (checks: ${status_color}${status}${RESET})"
        fi

        printf "  ${GREEN}%-6s${RESET} %-55s ${CYAN}%-14s${RESET} %-21s ${YELLOW}%-15s${RESET} %-14s %s\n" \
            "#${num}" "$title" "$author_login" "$branch" "$base" "$review" "$mergeable_display"
    done <<< "$(echo "$prs" | jq -c '.[]')"
}

cmd_status() {
    local pr_ref="${1:-}"
    local gh_args=(pr checks)

    if [[ -n "$pr_ref" ]]; then
        gh_args+=("$pr_ref")
    fi
    if [[ -n "$REPO" ]]; then
        gh_args+=(--repo "$REPO")
    fi

    gh "${gh_args[@]}"
}

cmd_review() {
    local pr_number=""

    pr_number="$(select_pr)"
    if [[ -z "$pr_number" ]]; then
        log_error "No PR selected"
        return 1
    fi

    review_pr "$pr_number"
}

select_pr() {
    local prs
    prs="$(fetch_prs_json)"

    if [[ -z "$prs" || "$prs" == "[]" ]]; then
        log_warn "No pull requests found" >&2
        return 1
    fi

    # Batch-fetch required-check status for all listed PRs.
    local checks_map
    checks_map="$(printf '%s\n' "$prs" | jq -r '.[].number' | batch_checks_status)" || checks_map=""

    echo -e "${BOLD}${CYAN}Select a pull request:${RESET}" >&2
    echo "" >&2

    local numbers=()
    local i=1

    while IFS= read -r line; do
        local num title author branch base review mergeable
        num="$(echo "$line" | jq -r '.number')"
        title="$(sanitize "$(echo "$line" | jq -r '.title')")"
        author="$(sanitize "$(echo "$line" | jq -r '.author.login')")"
        branch="$(sanitize "$(echo "$line" | jq -r '.headRefName')")"
        base="$(sanitize "$(echo "$line" | jq -r '.baseRefName')")"
        review="$(echo "$line" | jq -r '.reviewDecision')"
        mergeable="$(echo "$line" | jq -r '.mergeable')"

        local status
        status="$(lookup_check_status "$num" "$checks_map")" || status=""

        local review_color="${YELLOW}"
        if [[ "$review" == "APPROVED" ]]; then
            review_color="${GREEN}"
        elif [[ "$review" == "CHANGES_REQUESTED" ]]; then
            review_color="${RED}"
        fi

        local merge_color="${GREEN}"
        if [[ "$mergeable" == "CONFLICTING" ]]; then
            merge_color="${RED}"
        fi

        local status_part=""
        if [[ -n "$status" ]]; then
            local status_color
            status_color="$(color_for_status "$status")"
            status_part=" (checks: ${status_color}${status}${RESET})"
        fi

        echo -e "  ${BOLD}${i})${RESET}  ${GREEN}#${num}${RESET}  ${title}" >&2
        echo -e "      ${DIM}by ${CYAN}${author}${RESET} ${DIM}| ${branch} → ${base} | review: ${review_color}${review}${RESET} | merge: ${merge_color}${mergeable}${RESET}${status_part}" >&2

        numbers+=("$num")
        ((i++)) || true
    done <<< "$(echo "$prs" | jq -c '.[]')"

    echo "" >&2
    echo -e "  ${BOLD}0)${RESET}  Exit" >&2
    echo "" >&2

    read -rp "$(echo -e "${BOLD}Select PR [1-$((i-1))]: ${RESET}")" choice

    if [[ "$choice" == "0" || -z "$choice" ]]; then
        return 1
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 ]] || [[ "$choice" -ge "$i" ]]; then
        log_error "Invalid selection: $choice" >&2
        return 1
    fi

    echo "${numbers[$((choice-1))]}"
}

review_pr() {
    local pr_number="$1"
    local repo_args=()
    if [[ -n "$REPO" ]]; then
        repo_args+=(--repo "$REPO")
    fi

    local current_user
    current_user="$(gh api user --jq .login 2>/dev/null)" || current_user=""

    while true; do
        echo ""
        echo -e "${BOLD}${CYAN}══════════════════════════════════════════════════════${RESET}"
        echo -e "${BOLD}  PR #${pr_number}${RESET}"

        local pr_info
        pr_info="$(gh pr view "$pr_number" ${repo_args[@]+"${repo_args[@]}"} --json title,author,headRefName,baseRefName,state,reviewDecision,mergeable,url 2>/dev/null)" || {
            log_error "Could not fetch PR #$pr_number"
            return 1
        }

        local title author branch base state review mergeable url
        title="$(sanitize "$(echo "$pr_info" | jq -r '.title')")"
        author="$(sanitize "$(echo "$pr_info" | jq -r '.author.login')")"
        branch="$(sanitize "$(echo "$pr_info" | jq -r '.headRefName')")"
        base="$(sanitize "$(echo "$pr_info" | jq -r '.baseRefName')")"
        state="$(echo "$pr_info" | jq -r '.state')"
        review="$(echo "$pr_info" | jq -r '.reviewDecision')"
        mergeable="$(echo "$pr_info" | jq -r '.mergeable')"
        url="$(echo "$pr_info" | jq -r '.url')"

        local status
        status="$(checks_status "$pr_number" || true)"
        [[ -z "$status" ]] && status=""

        local status_part=""
        if [[ -n "$status" ]]; then
            local status_color
            status_color="$(color_for_status "$status")"
            status_part=" | checks: ${status_color}${status}${RESET}"
        fi

        local is_self_authored=false
        if [[ -n "$current_user" && "$author" == "$current_user" ]]; then
            is_self_authored=true
        fi

        echo -e "  ${BOLD}${title}${RESET}"
        echo -e "  ${DIM}by ${CYAN}${author}${RESET} ${DIM}| ${branch} → ${base} | state: ${state}${RESET}"
        echo -e "  ${DIM}review: ${review} | mergeable: ${mergeable}${RESET}${status_part}"
        echo -e "  ${DIM}${url}${RESET}"
        echo -e "${BOLD}${CYAN}══════════════════════════════════════════════════════${RESET}"

        echo ""
        log_info "Showing diff for PR #${pr_number}..."
        gh pr diff "$pr_number" ${repo_args[@]+"${repo_args[@]}"} || true
        echo ""

        echo -e "  ${BOLD}1)${RESET}  View CI status"
        if $is_self_authored; then
            echo -e "  ${BOLD}2)${RESET}  Approve PR ${DIM}(n/a for own PRs)${RESET}"
        else
            echo -e "  ${BOLD}2)${RESET}  Approve PR"
        fi
        echo -e "  ${BOLD}3)${RESET}  Merge PR (${MERGE_STRATEGY})"
        echo -e "  ${BOLD}4)${RESET}  Sync base branch (${base})"
        if $is_self_authored; then
            echo -e "  ${BOLD}5)${RESET}  Merge + Sync (full workflow)"
        else
            echo -e "  ${BOLD}5)${RESET}  Approve + Merge + Sync (full workflow)"
        fi
        echo -e "  ${BOLD}6)${RESET}  Open in browser"
        echo -e "  ${BOLD}0)${RESET}  Back / Exit"
        echo ""

        read -rp "$(echo -e "${BOLD}Action: ${RESET}")" action

        case "$action" in
            1)
                echo ""
                log_info "Checking CI status for PR #${pr_number}..."
                gh pr checks "$pr_number" ${repo_args[@]+"${repo_args[@]}"} || true
                ;;
            2)
                echo ""
                if $is_self_authored; then
                    log_info "Cannot approve your own PR (#${pr_number}) -- GitHub forbids self-approval"
                else
                    approve_pr "$pr_number" ${repo_args[@]+"${repo_args[@]}"}
                fi
                ;;
            3)
                echo ""
                merge_pr "$pr_number" ${repo_args[@]+"${repo_args[@]}"}
                ;;
            4)
                echo ""
                pull_pr "$pr_number" "$branch" "$base" ${repo_args[@]+"${repo_args[@]}"}
                ;;
            5)
                echo ""
                local success=true
                if $is_self_authored; then
                    log_info "PR #${pr_number} authored by you -- skipping approval"
                else
                    approve_pr "$pr_number" ${repo_args[@]+"${repo_args[@]}"} || success=false
                fi
                if $success; then
                    merge_pr "$pr_number" ${repo_args[@]+"${repo_args[@]}"} || success=false
                fi
                if $success; then
                    pull_pr "$pr_number" "$branch" "$base" ${repo_args[@]+"${repo_args[@]}"}
                fi
                if $success; then
                    echo ""
                    log_success "Full workflow completed for PR #${pr_number}!"
                    return 0
                else
                    log_warn "Workflow did not complete fully"
                fi
                ;;
            6)
                gh pr view "$pr_number" ${repo_args[@]+"${repo_args[@]}"} --web || true
                ;;
            0|"")
                return 0
                ;;
            *)
                log_error "Unknown action: $action"
                ;;
        esac
    done
}

approve_pr() {
    local pr_number="$1"
    shift
    local repo_args=("$@")

    log_info "Approving PR #${pr_number}..."
    if gh pr review "$pr_number" ${repo_args[@]+"${repo_args[@]}"} --approve; then
        log_success "PR #${pr_number} approved"
    else
        log_error "Failed to approve PR #${pr_number}"
        return 1
    fi
}

merge_pr() {
    local pr_number="$1"
    shift
    local repo_args=("$@")

    local merge_flag="--squash"
    case "$MERGE_STRATEGY" in
        squash)   merge_flag="--squash" ;;
        merge)    merge_flag="--merge" ;;
        rebase)   merge_flag="--rebase" ;;
        *)
            log_error "Unknown merge strategy: $MERGE_STRATEGY"
            return 1
            ;;
    esac

    log_info "Merging PR #${pr_number} (strategy: ${MERGE_STRATEGY})..."
    if gh pr merge "$pr_number" ${repo_args[@]+"${repo_args[@]}"} "$merge_flag" --delete-branch; then
        log_success "PR #${pr_number} merged"
    else
        log_error "Failed to merge PR #${pr_number}"
        return 1
    fi
}

pull_pr() {
    local pr_number="$1"
    shift
    local branch="$1"
    shift
    local base="$1"
    shift
    local repo_args=("$@")

    if [[ -n "$REPO" ]]; then
        log_warn "Cannot pull when using --repo flag (different remote)"
        log_info "Switch to the repo directory and run: git checkout $base && git pull"
        return 0
    fi

    log_info "Switching to ${base} and pulling..."
    if git checkout "$base" && git pull; then
        log_success "Pulled latest ${base}"
    else
        log_error "Failed to checkout/pull ${base}"
        return 1
    fi
}

validate_flag_value() {
    if [[ $# -lt 2 || -z "${2-}" ]]; then
        echo "Error: $1 requires a value." >&2
        usage
        exit 1
    fi
}

main() {
    local command=""
    local remaining_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            list|status|review)
                if [[ -n "$command" ]]; then
                    echo "Error: Multiple subcommands given: $command and $1" >&2
                    usage
                    exit 1
                fi
                command="$1"
                shift
                ;;
            help|--help|-h)
                usage
                exit 0
                ;;
            --version)
                version
                exit 0
                ;;
            -R|--repo)
                validate_flag_value "$@"
                REPO="$2"
                shift 2
                ;;
            -A|--author)
                validate_flag_value "$@"
                AUTHOR="$2"
                shift 2
                ;;
            -l|--label)
                validate_flag_value "$@"
                LABEL="$2"
                shift 2
                ;;
            -s|--state)
                validate_flag_value "$@"
                STATE="$2"
                shift 2
                ;;
            -L|--limit)
                validate_flag_value "$@"
                LIMIT="$2"
                shift 2
                ;;
            -S|--search)
                validate_flag_value "$@"
                SEARCH="$2"
                shift 2
                ;;
            --merge-strategy)
                validate_flag_value "$@"
                MERGE_STRATEGY="$2"
                shift 2
                ;;
            *)
                if [[ -z "$command" ]]; then
                    echo "Error: Unknown argument: $1" >&2
                    usage
                    exit 1
                fi
                if [[ "$1" == -* ]]; then
                    echo "Error: Unknown flag: $1" >&2
                    usage
                    exit 1
                fi
                remaining_args+=("$1")
                shift
                ;;
        esac
    done

    case "$command" in
        list)
            check_dependencies
            cmd_list
            ;;
        status)
            check_dependencies
            cmd_status "${remaining_args[0]:-}"
            ;;
        review|"")
            check_dependencies
            cmd_review
            ;;
    esac
}

main "$@"
